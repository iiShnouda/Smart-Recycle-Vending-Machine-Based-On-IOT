# This file is used to ignore files which are generated
# ----------------------------------------------------------------------------

*~
*.autosave
*.a
*.core
*.moc
*.o
*.obj
*.orig
*.rej
*.so
*.so.*
*_pch.h.cpp
*_resource.rc
*.qm
.#*
*.*#
core
!core/
tags
.DS_Store
.directory
*.debug
Makefile*
*.prl
*.app
moc_*.cpp
ui_*.h
qrc_*.cpp
Thumbs.db
*.res
*.rc
/.qmake.cache
/.qmake.stash

# qtcreator generated files
*.pro.user*
*.qbs.user*
CMakeLists.txt.user*

# xemacs temporary files
*.flc

# Vim temporary files
.*.swp

# Visual Studio generated files
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*

# MinGW generated files
*.Debug
*.Release

# Python byte code
*.pyc

# Binaries
# --------
*.dll
*.exe

# Directories with generated files
.moc/
.obj/
.pch/
.rcc/
.uic/
/build*/
/.qt/

# Qt Creator workspace state (per-developer)
.qtcreator/
CMakeUserPresets.json

# Local Claude / agent state
.claude/

# Node / package noise (only present during dev tooling)
node_modules/
package-lock.json

# Python backend artifacts — never commit secrets or virtualenv
backend/.env
backend/venv/
backend/__pycache__/
backend/**/__pycache__/

# Advanced Installer build outputs (the .aip file IS tracked, but the
# produced installers are big and rebuildable from the project file).
packaging/AdvancedInstaller/output/
*.msi
*.exe-cache

# Built Linux packages — upload these to GitHub Releases, don't commit.
*.deb

# Stray QML helper that's not part of the qt_add_qml_module set
qml/translations.qml

# Local-only diagnostic / scratch scripts (contain LAN credentials)
_pi_diag.py
_pi_*.py
