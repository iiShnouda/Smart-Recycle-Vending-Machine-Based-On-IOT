# /etc/rewingo/.env — kiosk runtime configuration.
#
# Copy this file to /etc/rewingo/.env (postinst does it for you on a fresh
# install) and fill in real broker credentials before launching the kiosk.

# ── MQTT broker ──────────────────────────────────────────────────────────
# Hostname of your MQTT broker. Examples:
#   - HiveMQ Cloud:           xxx.s2.eu.hivemq.cloud
#   - EMQX Cloud Serverless:  zzz.ala.eu-central-1.emqxsl.com
#   - Self-hosted Mosquitto:  192.168.1.100
MQTT_HOST=

# Port. 8883 for TLS (the public clouds), 1883 for plain (local Mosquitto).
MQTT_PORT=8883

# Username + password from the broker's "Access Management" / "Credentials"
# page. Leave both blank for an anonymous local broker.
MQTT_USERNAME=
MQTT_PASSWORD=

# Toggle TLS. "1" = on (recommended for any internet-facing broker),
# "0" = plain (only OK for a self-hosted Mosquitto on the LAN).
MQTT_TLS=1

# ── MongoDB (used by the rewingo-bridge service, not the kiosk app) ─────────
# The bridge subscribes to the broker above and stores every message in Mongo.
# Atlas: Cluster → Connect → Drivers → copy the URI and add your DB password.
# Leave MONGODB_URI blank if you are not running the bridge.
MONGODB_URI=
MONGODB_DB=rewingo
