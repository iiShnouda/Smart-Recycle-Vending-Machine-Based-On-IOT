# rewingo-bridge configuration.
#
# The bridge reads /etc/rewingo/.env (the SAME file the kiosk uses) so all
# config lives in one place. These are the keys the bridge cares about — add
# them to your existing /etc/rewingo/.env. (install.sh seeds this file only if
# /etc/rewingo/.env does not already exist, so it won't clobber the app's config.)

# ── MQTT broker (the local Mosquitto on the Pi) ──────────────────────────────
# IMPORTANT: for telemetry to flow, the *kiosk* must also point here — set the
# same MQTT_HOST in /etc/rewingo/.env, otherwise the app runs offline and
# publishes nothing for the bridge to relay.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=0
MQTT_TOPIC=rewingo/#

# ── MongoDB Atlas (or any mongodb:// URI) — REQUIRED ─────────────────────────
# Atlas: Cluster → "Connect" → "Drivers" → copy the connection string and put
# your DB password in it. Example:
#   mongodb+srv://rewingo:PASSWORD@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=rewingo

# DEBUG to see every routed message; INFO is the sensible default.
LOG_LEVEL=INFO
