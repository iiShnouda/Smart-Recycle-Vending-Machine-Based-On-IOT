# Copy to .env locally, OR set these as Environment Variables in your cloud host.
# (Never commit the real values.)

# MongoDB Atlas — use the STANDARD (non-SRV) seed-list URI.
MONGODB_URI=mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=...&authSource=admin&retryWrites=true&w=majority
MONGODB_DB=rewingo

# Signs the login tokens — must MATCH the kiosk + the old Pi backend.
JWT_SECRET=change-me-to-the-same-secret-as-the-pi

# HiveMQ Cloud broker (the same one the kiosk + app use).
MQTT_HOST=xxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=ReWinGo
MQTT_PASSWORD=your-hivemq-password

# HTTP health port — most hosts set PORT automatically; leave default otherwise.
PORT=8080
