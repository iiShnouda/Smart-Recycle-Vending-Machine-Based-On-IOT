# ReWinGo kiosk backend — copy to ".env" and fill in MONGODB_URI.
MQTT_HOST=f5248f86bfed44398ce41cdf27760831.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=ReWinGo
MQTT_PASSWORD=your-hivemq-password

# From MongoDB Atlas → Cluster0 → Connect → Drivers. Looks like:
# mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=rewingo

PORT=3001
