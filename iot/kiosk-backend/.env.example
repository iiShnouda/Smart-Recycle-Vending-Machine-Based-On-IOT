# ReWinGo kiosk backend — copy to ".env" and fill in MONGODB_URI.
MQTT_HOST=f5248f86bfed44398ce41cdf27760831.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=ReWinGo
MQTT_PASSWORD=your-hivemq-password

# From MongoDB Atlas → Cluster0 → Connect → Drivers:
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# NOTE: if your network blocks SRV/TXT DNS lookups (some phone hotspots do),
# the mongodb+srv:// form times out (queryTxt ETIMEOUT). Use the STANDARD
# seed-list URI instead — it resolves the shard hosts via plain A-records:
#   mongodb://USER:PASS@h1:27017,h2:27017,h3:27017/?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin&retryWrites=true&w=majority
# (get the shard hosts + replicaSet from Atlas, or resolve _mongodb._tcp.<cluster> over DoH).
MONGODB_URI=
MONGODB_DB=rewingo

PORT=3001
