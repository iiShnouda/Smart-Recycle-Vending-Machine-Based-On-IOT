# ReWinGo kiosk — MQTT broker config (HiveMQ Cloud).
#
# Copy this file to:
#   Windows (testing): C:\rewingo\.env
#   Raspberry Pi      : /etc/rewingo/.env
#
# Then fill in MQTT_HOST from your HiveMQ Cloud cluster's "Overview" tab
# (looks like  abcd1234....s1.eu.hivemq.cloud ).

MQTT_HOST=f5248f86bfed44398ce41cdf27760831.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=ReWinGo
MQTT_PASSWORD=your-hivemq-password
MQTT_TLS=1

# MongoDB does NOT connect to MQTT directly — the backend subscribes to
# HiveMQ and writes to Mongo. Put the Atlas URI in the BACKEND's env, not here.
