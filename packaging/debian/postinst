#!/bin/bash
# postinst — runs after dpkg unpacks the files.
#
# Idempotent: re-running on an upgrade tops everything up without
# clobbering the live /etc/rewingo/.env credentials.

set -e

PREFIX=/opt/rewingo
DATA_DIR=/var/lib/rewingo
ETC_DIR=/etc/rewingo
VENV="$PREFIX/backend/venv"

echo "rewingo: post-install setup…"

# 1. Runtime data dir (SQLite, logs, downloaded catalog images).
mkdir -p "$DATA_DIR"
chmod 0775 "$DATA_DIR"

# 2. Config dir + .env template. NEVER overwrite a live .env.
mkdir -p "$ETC_DIR"
if [ ! -f "$ETC_DIR/.env" ]; then
  if [ -f "$PREFIX/backend/.env.example" ]; then
    cp "$PREFIX/backend/.env.example" "$ETC_DIR/.env"
    chmod 0640 "$ETC_DIR/.env"
    echo "rewingo: copied .env.example to $ETC_DIR/.env (edit before running)"
  else
    cat > "$ETC_DIR/.env" <<'EOF'
# Fill in before running rewingo-backend.
# MONGO_URI=mongodb+srv://…
# MONGO_DB=rewingo
# BACKEND_API_KEY=replace-me
EOF
    chmod 0640 "$ETC_DIR/.env"
  fi
fi

# 3. Python virtualenv for the Flask backend. First install creates it;
#    upgrades reuse the existing venv unless you blow it away first.
if [ ! -d "$VENV" ]; then
  echo "rewingo: creating Python virtualenv at $VENV …"
  python3 -m venv "$VENV"
fi

if [ -f "$PREFIX/backend/requirements.txt" ]; then
  echo "rewingo: installing backend Python deps …"
  "$VENV/bin/pip" install --quiet --upgrade pip
  "$VENV/bin/pip" install --quiet -r "$PREFIX/backend/requirements.txt"
fi

# 4. Refresh XDG caches so the menu entry + icon show up without logout.
command -v update-desktop-database >/dev/null 2>&1 && \
  update-desktop-database -q || true
command -v gtk-update-icon-cache    >/dev/null 2>&1 && \
  gtk-update-icon-cache -q /usr/share/icons/hicolor || true

echo "rewingo: install complete."
echo
echo "  Edit MongoDB creds:  $ETC_DIR/.env"
echo "  Start the UI:         rewingo"
echo "  Start the backend:    rewingo-backend"
echo

exit 0
