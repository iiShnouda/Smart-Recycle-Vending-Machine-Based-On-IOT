#!/bin/bash
# prerm — runs before dpkg removes the files.
#
# `$1` tells us which lifecycle we're in:
#   remove | upgrade | deconfigure | failed-upgrade
# We don't touch /var/lib/rewingo here — `apt purge` triggers postrm
# which handles that, and a plain remove should preserve user data.

set -e

case "$1" in
  remove|upgrade|deconfigure)
    # Stop the systemd service. On `upgrade` postinst restarts it with
    # the new files; on `remove` it stays down + disabled.
    if command -v systemctl >/dev/null 2>&1; then
      if [ "$1" = "remove" ]; then
        systemctl disable rewingo-backend.service >/dev/null 2>&1 || true
      fi
      systemctl stop rewingo-backend.service 2>/dev/null || true
    fi
    # Fallback: kill any stray manual instances (e.g. legacy installs
    # that ran the backend by hand in a terminal).
    if pgrep -f /opt/rewingo/backend/server.py >/dev/null 2>&1; then
      pkill -f /opt/rewingo/backend/server.py || true
      sleep 1
    fi
    ;;
  failed-upgrade)
    ;;
  *)
    echo "prerm called with unknown argument: $1" >&2
    exit 1
    ;;
esac

exit 0
